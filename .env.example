# ---------------------------------------------------------------------------
# FinanceApp — environment variables
# Copy this file to `.env` for local development. NEVER commit `.env`.
#
# In production GitHub Actions sets FINANCE_MONGODB_URI, FINANCE_MONGODB_DB and
# FINANCE_TIMEZONE (see .github/workflows/build.yml); src-tauri/src/lib.rs bakes
# those three into the Rust binary through `option_env!`. Users can override the
# MongoDB connection at runtime from the login setup dialog or Settings →
# Database, which is the recommended production flow. FINANCE_JWT_SECRET and
# FINANCE_LOG_LEVEL are runtime variables and are not baked.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string.
# Create a dedicated database user with readWrite on `finance_app` only.
FINANCE_MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=FinanceApp"

# Database name (default: finance_app)
FINANCE_MONGODB_DB="finance_app"

# JWT signing secret (min. 32 random chars). Leave empty in development:
# the backend generates a persistent secret in the OS app-data directory.
# In production prefer leaving this empty too, so every installation gets
# its own unique secret.
FINANCE_JWT_SECRET=""

# IANA timezone used for day/month boundaries (default: Asia/Jakarta)
FINANCE_TIMEZONE="Asia/Jakarta"

# DEBUG | INFO | WARNING | ERROR
FINANCE_LOG_LEVEL="INFO"
