{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinanceApp",
  "version": "0.1.0",
  "identifier": "app.finance.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src-frontend/build",
    "features": ["pytauri/standalone"]
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FinanceApp",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#f8fafc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Keuangan pribadi, rapi.",
    "longDescription": "FinanceApp adalah aplikasi desktop lintas platform untuk mencatat pemasukan, pengeluaran, dan saldo dompet dengan grafik dan ringkasan bulanan.",
    "copyright": "Copyright © 2026 FinanceApp",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
